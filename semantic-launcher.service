[Unit]
Description=Semantic App Launcher Daemon
Documentation=https://github.com/dargem/semantic-launcher
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# If installed to ~/.local/bin or /usr/local/bin, update the path accordingly:
ExecStart=%h/.local/bin/semantic-launcher --daemon
Restart=on-failure
RestartSec=3
Environment=QT_QPA_PLATFORM=wayland
Environment=QT_WAYLAND_SHELL_INTEGRATION=layer-shell

[Install]
WantedBy=graphical-session.target
